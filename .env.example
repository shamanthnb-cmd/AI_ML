@"
AI_ENV=development
LOG_LEVEL=INFO
AI_SERVICE_PORT=8000
MODEL_DIR=/app/models
DETECTION_MODEL_PATH=/app/models/detection/scrfd.onnx
RECOGNITION_MODEL_PATH=/app/models/recognition/mobilefacenet.onnx
ANTI_SPOOFING_MODEL_PATH=/app/models/anti_spoofing/minifasnetv2.onnx
ONNX_NUM_THREADS=4
SIMILARITY_THRESHOLD=0.8
LIVENESS_THRESHOLD=
"@ | Set-Content -Path .env.example -Encoding utf8